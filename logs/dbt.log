    `sales_of_fmcg_stores`.`monthly_revenue__dbt_tmp`
    
    
      as
    
    (
      select
    date_format(s.SalesDate, '%Y-%m') as SalesMonth,
    sum(s.Quantity * p.Price * (1 - s.Discount)) as Revenue,
    sum(s.Quantity) as Quantity,
    count(*) as Transactions
